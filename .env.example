# ==============================================================================
# Distributed Log Ingestion Pipeline - Environment Configuration
# ==============================================================================

# Kafka Broker Configuration
LP_KAFKA_BROKERS=localhost:9094
LP_TOPIC_RAW_LOGS=raw-logs
LP_TOPIC_DLQ=raw-logs.dlq
LP_TOPIC_ALERTS=alerts

# Database Connection (TimescaleDB / PostgreSQL)
LP_DB_URI=postgresql://postgres:postgres@localhost:5432/postgres

# Redis Connection (Detector State Store)
LP_REDIS_URI=redis://localhost:6379/0

# Producer & Generator Settings
LP_PRODUCER_RATE=500.0
LP_NUM_CLIENTS=350
LP_LABELS_PATH=labels.jsonl
LP_RANDOM_SEED=42

# Consumer & Batch Processing Settings
LP_MAX_BATCH_SIZE=1000
LP_BATCH_TIMEOUT_SEC=1.0

# Web Dashboard & API Server Settings
LP_WEB_HOST=0.0.0.0
LP_WEB_PORT=8080
LP_ENVIRONMENT=development
LP_LOG_LEVEL=INFO
